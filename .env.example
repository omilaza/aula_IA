# Use a unique random value of at least 32 characters. Configure it as a secret;
# never expose it in client code or commit a real production value.
PDF_EXPORT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Primary Google Sheets storage. Deploy google-apps-script/ first.
# Configure these in Worker runtime secrets (not only build variables).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-me/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
